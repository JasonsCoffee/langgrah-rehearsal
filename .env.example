# Models. Format: <provider>:<model>
# The judge must run on a different model from the coder (docs/decisions.md D-12).
UNITY_CODER_MODEL=
JUDGE_MODEL=

# --- Unity adapter -----------------------------------------------------------
# Machine-local selectors; no automatic editor launch or version selection.
UNITY_EXE=
UNITY_HUB_ROOT=

# Dedicated complete verification host, never the interactive user project.
UNITY_PROJECT_ROOT=
# Independent game repository and external coordinator workspace.
GAME_REPOSITORY_ROOT=
CODING_WORKSPACE_ROOT=
# Optional configured endpoint; worker must still verify exact project identity.
UNITY_BRIDGE_URL=

# --- Optional tracing --------------------------------------------------------
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=langgraph-coding-framework

# --- Provider credentials ----------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
