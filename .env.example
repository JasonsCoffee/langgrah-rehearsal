# Models. Format: <provider>:<model>
# The judge must run on a different model from the coder (docs/decisions.md D-12).
UNITY_CODER_MODEL=
JUDGE_MODEL=

# --- Unity adapter -----------------------------------------------------------
# Full path to Unity.exe on this machine. Leave empty to fall back to
# UNITY_HUB_ROOT, then to %PROGRAMFILES%/Unity/Hub/Editor (newest version wins).
UNITY_EXE=
UNITY_HUB_ROOT=

# Target Unity project. Also passable as --project-root on the CLI.
UNITY_PROJECT_ROOT=

# --- Optional tracing --------------------------------------------------------
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=langgraph-coding-framework

# --- Provider credentials ----------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
